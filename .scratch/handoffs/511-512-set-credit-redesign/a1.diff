+// ROUND 2E-1 TEMPORARY: every set figure as a linear combination of raw sims,
+// so its se counts each shared sim (baseline, prefix singles) once with its
+// net coefficient. Independent-sims assumption; all sims share seeds[0].
+type DiagTerms = Map<string, { coef: number; dps: number; se: number }>;
+function diagAdd(
+  t: DiagTerms,
+  key: string,
+  coef: number,
+  dps: number,
+  se: number
+): void {
+  const cur = t.get(key);
+  if (cur) cur.coef += coef;
+  else t.set(key, { coef, dps, se });
+}
+function diagAddAll(t: DiagTerms, other: DiagTerms, factor: number): void {
+  for (const [k, v] of other) diagAdd(t, k, factor * v.coef, v.dps, v.se);
+}
+function diagSingle(
+  t: DiagTerms,
+  individualDeltasByItemId: ReadonlyMap<number, IndividualDelta>,
+  baseline: DpsSample,
+  itemId: number,
+  coef: number
+): void {
+  const ind = individualDeltasByItemId.get(itemId);
+  if (!ind) return;
+  const baseKey = ind.baseKey ?? "base";
+  const raw = ind.rawDps ?? ind.deltaDps + baseline.dps;
+  diagAdd(t, `s:${itemId}`, coef, raw, ind.se);
+  diagAdd(
+    t,
+    baseKey,
+    -coef,
+    raw - ind.deltaDps,
+    baseKey === "base" ? baseline.se : Number.NaN
+  );
+}
+function diagSe(t: DiagTerms): number {
+  let sum = 0;
+  for (const v of t.values()) sum += (v.coef * v.se) ** 2;
+  return Math.sqrt(sum);
+}
+function diagVal(t: DiagTerms): number {
+  let sum = 0;
+  for (const v of t.values()) sum += v.coef * v.dps;
+  return sum;
+}
+function diagOut(t: DiagTerms): { key: string; coef: number; dps: number; se: number }[] {
+  return [...t]
+    .filter(([, v]) => Math.abs(v.coef) > 1e-9)
+    .map(([key, v]) => ({ key, ...v }));
+}

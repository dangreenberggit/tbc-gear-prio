node_modules/
.env
__pycache__/
coverage/
.data/
dist/
# apps/web builds the server to a sibling of the client's dist/, so the rule
# above does not cover it. Both are build output; neither is ever committed.
dist-server/
*.tsbuildinfo

# Pinned wowsims build inputs — fetched by `pnpm sync:wowsims`, never committed.
# What we commit is the *generated* output (data/items/index.json, data/gems/
# palette.json) plus data/wowsims.lock.json, which records exactly which upstream
# release those were generated from. See PLAN.md §8.5.
vendor/

# Agent worktrees (parallel-phase). Never tracked. Also excluded from vitest
# (see vitest.config.ts). Tracked here so every clone gets it — .git/info/exclude
# is per-checkout only.
.claude/worktrees/

# Embedded clones/worktrees under .scratch — reference checkouts, never ours to commit.
# wowsims-tbc-new-src is the game-mechanics authority (see AGENTS.md).
.scratch/wowsims-tbc-new-src/
.scratch/wt-*/

# .scratch/ does two jobs: it holds the tracked issue tracker and archive, AND it
# is where agents dump working files. Without this, every probe script, log and
# JSON dump left behind by a session shows up as untracked and trips `pnpm merge-to-dev`'s
# clean-tree check — which is how 92 files accumulated before 2026-08-04.
#
# So: ignore the contents by default, re-include what is meant to be kept. Note the
# `/*` rather than `/` — git will not descend into a fully-ignored directory, and
# the `!` re-includes below would silently never match.
#
# Already-tracked files are unaffected either way: .gitignore only governs files
# git does not yet know about. Verify a path with `git check-ignore -v <path>`.
#
# WARNING: `git clean -fdx` deletes ignored files too, and ignored files no longer
# appear in `git status`. Anything under here that is not re-included below is
# genuinely disposable — if you want it to survive, commit it or archive it.
.scratch/*
!.scratch/carry-forward/
!.scratch/phase-2/
!.scratch/set-bonus-value/
!.scratch/archive/
!.scratch/handoffs/
!.scratch/phase0-close/
!.scratch/stash-salvage/
!.scratch/ticket-18/
!.scratch/ticket-20/

# Stage-gate pipeline evidence and the rank reports a gate cites. These are not
# disposable working files: docs/verification-log.md's Stage 2 entry quotes them
# as the evidence the gate box was closed on, and `git clean -fdx` would delete
# an ignored file the log points at.
!.scratch/stage-gate/
.scratch/stage-gate/*
!.scratch/stage-gate/stage-2-close-shortlist-box/
!.scratch/stage-gate/worn-item-pool-coverage/
!.scratch/stage-gate/stage-3-web-shell/
!.scratch/stage-gate/finish-the-tab/
!.scratch/stage-gate/phase-item-pool/
!.scratch/stage-gate/upgrades-ui-quality/
!.scratch/stage-gate/tickets-306-308/
!.scratch/stage-gate/upgrades-ui-rebuild/
!.scratch/stage-gate/342-learn-from-upstream/
!.scratch/stage-gate/reforge-catchup-leftovers/
!.scratch/stage-gate/ticket-365-dual-wield-fixture/
!.scratch/stage-gate/ticket-362-item-swap-database/
!.scratch/stage-gate/skeleton-scope-and-local-dev-fixture/
!.scratch/stage-gate/two-hander-clears-offhand/
!.scratch/stage-gate/ledger-consolidation-and-merge-train/
!.scratch/stage-gate/merge-ready-disposition-parser/
!.scratch/stage-gate/desktop-transport-gate/
!.scratch/stage-gate/bulk-finalist-cost/
!.scratch/rank-reports/
.scratch/rank-reports/*
!.scratch/rank-reports/stage2-close-*.json
!.scratch/rank-reports/stage2-close-*.stdout.txt

# Ticket 235 lock-race reproduction. docs/workflow.md cites these two scripts as
# the evidence for the lint-staged flags, so they are tracked; the throwaway git
# repos they build (lab-*) are not.
!.scratch/repro-235/
.scratch/repro-235/*
!.scratch/repro-235/repro.sh
!.scratch/repro-235/happy-path.sh

# The phase-2 verification UI: a dev harness for eyeballing real rank output for
# three characters across raid zones. The shell and its generator are tracked;
# everything they produce is not. reports/ is ~3MB of HTML+JSON regenerated on
# every run and goes stale the moment the ranking changes, so committing it
# would re-commit megabytes to ship output that contradicts the code.
# Regenerate with `bash .scratch/phase2-verify-ui/gen-zone-reports.sh`.
!.scratch/phase2-verify-ui/
.scratch/phase2-verify-ui/*
!.scratch/phase2-verify-ui/index.html
!.scratch/phase2-verify-ui/gen-zone-reports.sh

# handoffs/ is re-included above because live worker handoffs belong in git, but
# these are session byproduct: process logs, superseded fix plans whose fixes have
# shipped, and scraper/diff residue. Durable investigations were moved to
# .scratch/archive/<month>/ on 2026-08-04 — put keepers there, not here.
.scratch/handoffs/pipeline-loop-*
.scratch/handoffs/*-fix-plan.md
.scratch/handoffs/*-wip.md
.scratch/handoffs/raid-scoped-pool-redesign/

node_modules/
.env
__pycache__/
coverage/
.data/
dist/
*.tsbuildinfo

# Pinned wowsims build inputs — fetched by `pnpm sync:wowsims`, never committed.
# What we commit is the *generated* output (data/items/index.json, data/gems/
# palette.json) plus data/wowsims.lock.json, which records exactly which upstream
# release those were generated from. See PLAN.md §8.5.
vendor/

# Agent worktrees (parallel-phase). Never tracked. Also excluded from vitest
# (see vitest.config.ts). Tracked here so every clone gets it — .git/info/exclude
# is per-checkout only.
.claude/worktrees/

# Embedded clones/worktrees under .scratch — reference checkouts, never ours to commit.
# wowsims-tbc-new-src is the game-mechanics authority (see AGENTS.md).
.scratch/wowsims-tbc-new-src/
.scratch/wt-*/

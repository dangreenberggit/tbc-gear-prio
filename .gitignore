node_modules/
.env
__pycache__/
coverage/
.data/
dist/
*.tsbuildinfo

# Pinned wowsims build inputs — fetched by `pnpm sync:wowsims`, never committed.
# What we commit is the *generated* output (data/items/index.json, data/gems/
# palette.json) plus data/wowsims.lock.json, which records exactly which upstream
# release those were generated from. See PLAN.md §8.5.
vendor/

# Agent worktrees (parallel-phase). Never tracked. Also excluded from vitest
# (see vitest.config.ts). Tracked here so every clone gets it — .git/info/exclude
# is per-checkout only.
.claude/worktrees/

# Embedded clones/worktrees under .scratch — reference checkouts, never ours to commit.
# wowsims-tbc-new-src is the game-mechanics authority (see AGENTS.md).
.scratch/wowsims-tbc-new-src/
.scratch/wt-*/

# .scratch/ does two jobs: it holds the tracked issue tracker and archive, AND it
# is where agents dump working files. Without this, every probe script, log and
# JSON dump left behind by a session shows up as untracked and trips `pnpm land`'s
# clean-tree check — which is how 92 files accumulated before 2026-08-04.
#
# So: ignore the contents by default, re-include what is meant to be kept. Note the
# `/*` rather than `/` — git will not descend into a fully-ignored directory, and
# the `!` re-includes below would silently never match.
#
# Already-tracked files are unaffected either way: .gitignore only governs files
# git does not yet know about. Verify a path with `git check-ignore -v <path>`.
#
# WARNING: `git clean -fdx` deletes ignored files too, and ignored files no longer
# appear in `git status`. Anything under here that is not re-included below is
# genuinely disposable — if you want it to survive, commit it or archive it.
.scratch/*
!.scratch/carry-forward/
!.scratch/archive/
!.scratch/handoffs/
!.scratch/phase0-close/
!.scratch/stash-salvage/
!.scratch/ticket-18/
!.scratch/ticket-20/

# handoffs/ is re-included above because live worker handoffs belong in git, but
# these are session byproduct: process logs, superseded fix plans whose fixes have
# landed, and scraper/diff residue. Durable investigations were moved to
# .scratch/archive/<month>/ on 2026-08-04 — put keepers there, not here.
.scratch/handoffs/pipeline-loop-*
.scratch/handoffs/*-fix-plan.md
.scratch/handoffs/*-wip.md
.scratch/handoffs/raid-scoped-pool-redesign/

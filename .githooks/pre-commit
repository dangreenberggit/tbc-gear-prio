#!/usr/bin/env sh
# main only receives merges (see docs/workflow.md) — direct commits go to
# feature branches / occasionally to dev for tiny workflow fixes.
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "Refusing direct commit to main — branch off dev instead." >&2
  echo "(escape hatch: git commit --no-verify, spike/throwaway branches only)" >&2
  exit 1
fi

# Merges into dev must go through `pnpm merge-to-dev` (sets TBC_ALLOW_DEV_MERGE=1).
# Direct commits on dev (tiny workflow fixes) are still allowed.
merge_head=$(git rev-parse --git-path MERGE_HEAD 2>/dev/null)
if [ "$branch" = "dev" ] && [ -n "$merge_head" ] && [ -f "$merge_head" ]; then
  if [ "$TBC_ALLOW_DEV_MERGE" != "1" ]; then
    echo "Refusing merge into dev — use: pnpm merge-to-dev" >&2
    echo "(escape hatch: TBC_ALLOW_DEV_MERGE=1 git merge --no-ff <branch>)" >&2
    echo "(or: git commit --no-verify after a raw merge — spikes only)" >&2
    exit 1
  fi
fi

# --no-stash + --no-hide-partially-staged: never let lint-staged move working-tree
# content it might fail to put back. Its recovery path is `git reset --hard HEAD`
# then `git stash apply` (lint-staged 16.4.0 lib/gitWorkflow.js restoreOriginalState);
# a concurrent process holding .git/index.lock between those two steps leaves the
# tree wiped and the stash unapplied. Parallel agents share this checkout, so that
# race is routine. With both flags the worst case on a lock race is a failed commit
# with the working tree untouched. See ticket 235 and docs/workflow.md.
# Trade-off: the unstaged half of a partially staged file is formatted and committed.
npx lint-staged --no-stash --no-hide-partially-staged

{
  "name": "tbc-gear-prio",
  "version": "0.1.0",
  "private": true,
  "description": "tbc gear prio",
  "type": "module",
  "packageManager": "pnpm@10.6.2",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "verify": "pnpm run codegen:json-types:check && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test && pnpm run sim-defaults:check && pnpm run skeleton:check && pnpm run boss-aliases:check && pnpm run sync:atlasloot:verify-local && pnpm run atlasloot:regen:check && pnpm run rep-tables:check && pnpm run wowhead-prose:check && pnpm run curated-set-phase:check && pnpm run mirrors:check && pnpm run lock-merge:check && pnpm run sync-wowsims:unit:check && pnpm run feral-skeleton-apl:check",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "rank": "tsx packages/core/src/cli.ts",
    "sync:wowsims": "python scripts/sync_wowsims.py --update",
    "sync:wowsims:restore": "python scripts/sync_wowsims.py --restore",
    "sync:wowsims:check": "python scripts/sync_wowsims.py --check",
    "sync-wowsims:unit:check": "python scripts/check_sync_wowsims.py",
    "feral-skeleton-apl:check": "python scripts/check_build_feral_skeleton.py",
    "sync:atlasloot:restore": "python scripts/sync_atlasloot.py --restore",
    "sync:atlasloot:check": "python scripts/sync_atlasloot.py --check",
    "sync:atlasloot:verify-local": "python scripts/sync_atlasloot.py --verify-local",
    "atlasloot:regen:check": "python scripts/check_atlasloot_regen.py",
    "fetch:wowsimcli": "python scripts/fetch_wowsimcli.py",
    "fetch:protos": "python scripts/fetch_protos.py",
    "fetch:protos:check": "python scripts/fetch_protos.py --check",
    "proto:generate": "buf generate data/proto --template buf.gen.yaml && python scripts/normalize_proto_gen.py",
    "data:items:generate": "python scripts/generate_item_gem_index.py",
    "experiment:five-seed": "python scripts/five_seed_spread.py",
    "sim-defaults:build": "node scripts/extract_sim_defaults.mjs --spec feral",
    "sim-defaults:check": "node scripts/extract_sim_defaults.mjs --spec feral --check",
    "skeleton:check": "python scripts/check_raid_sim_skeleton.py && python scripts/check_raid_sim_skeleton.py --spec feral",
    "universe:assemble": "python scripts/assemble_universe.py",
    "land": "python scripts/land.py",
    "merge-ready": "python scripts/check_merge_ready.py",
    "issues:open": "python scripts/check_merge_ready.py --list-only",
    "boss-aliases:check": "python scripts/check_boss_aliases.py",
    "rep-tables:check": "python scripts/check_rep_tables.py",
    "wowhead-prose:check": "python scripts/check_wowhead_prose_suppression.py",
    "curated-set-phase:check": "python scripts/check_curated_set_phase.py",
    "mirrors:check": "python scripts/check_skill_mirrors.py",
    "lock-merge:check": "python scripts/check_lock_merge.py",
    "codegen:json-types": "python scripts/generate_json_literal_types.py",
    "codegen:json-types:check": "python scripts/generate_json_literal_types.py --check"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.72.0",
    "@bufbuild/protobuf": "^2.13.0",
    "@bufbuild/protoc-gen-es": "^2.13.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@bufbuild/buf"
    ]
  }
}

{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "rank-reports",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "http-server",
        ".scratch/rank-reports",
        "-p",
        "4173",
        "-c-1",
        "--silent"
      ],
      "port": 4173
    },
    {
      "name": "wowsims-fork",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev-tab.mjs", "frontend"],
      "port": 5173
    },
    {
      "name": "wowsims-backend",
      "runtimeExecutable": "node",
      "runtimeArgs": ["scripts/dev-tab.mjs", "backend"],
      "port": 3333,
      "autoPort": false
    },
    {
      "name": "wowsims-fork-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/http-server/bin/http-server",
        "dist",
        "-p",
        "4180",
        "-c-1"
      ],
      "cwd": "vendor/tbc-new-fork",
      "port": 4180
    },
    {
      "name": "web-shell",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "-C",
        "apps/web",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "web-shell-prod",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "apps/web/dist-server/main.js"
      ],
      "port": 3100,
      "env": {
        "PORT": "3100"
      }
    }
  ]
}
